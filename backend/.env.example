# Local: copy thành .env (không commit .env)
# Production (Render): điền các biến này trên dashboard Render, không commit.

# --- MongoDB ---
# Local:
MONGO_URL=mongodb://localhost:27017
# Atlas (Render): Network Access → Allow 0.0.0.0/0
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quyhoach?retryWrites=true&w=majority
DB_NAME=quyhoach

JWT_SECRET=dev-secret-change-me

# Dev local:
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Render / production:
# CORS_ORIGINS=https://quyhoach-web.vercel.app,https://quyhoach-citizen.vercel.app

