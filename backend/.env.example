# Local: copy thành .env (không commit .env)
# Production (Vercel): điền các biến này trên dashboard Vercel project quyhoach-api, không commit.

# --- MongoDB ---
# Local:
MONGO_URL=mongodb://localhost:27017
# Atlas (Vercel production): Network Access → Allow 0.0.0.0/0
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/quyhoach?retryWrites=true&w=majority
DB_NAME=quyhoach

JWT_SECRET=dev-secret-change-me

# Dev local:
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Vercel / production:
# CORS_ORIGINS=https://quyhoach-web.vercel.app,https://quyhoach-citizen.vercel.app

# Tùy chọn — tính năng AI compare trên mobile
# EMERGENT_LLM_KEY=

# PostGIS (docker compose). Để trống thì API đọc thửa/mái nhà từ Mongo.
# POSTGIS_DSN=postgresql://quyhoach:quyhoach@localhost:5432/quyhoach_gis

# Tài khoản demo: tự tạo nếu chưa có, không ghi đè mật khẩu đã đổi.
# true = đặt lại mật khẩu/role demo mỗi lần khởi động (chỉ dùng khi demo local).
# RESET_DEMO_ACCOUNTS=false
